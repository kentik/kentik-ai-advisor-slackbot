# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Kentik API Configuration
# US cluster: https://grpc.api.kentik.com
# EU cluster: https://grpc.api.kentik.eu
KENTIK_API_URL=https://grpc.api.kentik.com
KENTIK_API_EMAIL=your-email@company.com
KENTIK_API_TOKEN=your-api-token

# Optional Configuration
# Number of previous messages to include as context when starting conversation in existing thread
THREAD_CONTEXT_MESSAGES=5

# AI Advisor polling configuration (in seconds)
POLLING_INTERVAL_SECONDS=2
POLLING_TIMEOUT_SECONDS=120

# Database configuration
# Path to SQLite database file for storing conversation mappings
CONVERSATIONS_DB_PATH=conversations.db
